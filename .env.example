# Copy to /etc/quickprint/env (root-owned, chmod 600) in production. Never commit real values.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# SQLite database + private file storage (OCI block volume)
QP_DATA_DIR=/var/lib/quickprint
# Customer site and admin dashboard MUST be different origins
QP_PUBLIC_ORIGIN=https://print.example.com
QP_ADMIN_ORIGIN=https://admin.print.example.com
# Caddy runs on the same VM; trust only it for X-Forwarded-For
QP_TRUST_PROXY=loopback
QP_MAX_UPLOAD_MB=25
QP_RATE_LIMIT_PER_MIN=120
QP_LOG_LEVEL=info
# Encrypts the pickup PIN and admin authenticator secrets at rest; also signs admin CSRF tokens.
# Keep it safe and never change it after go-live (admins would need --reset). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
QP_DATA_KEY=
# Paytm PG (staging: WEBSTAGING + https://securegw-stage.paytm.in ; live: DEFAULT + https://securegw.paytm.in)
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
PAYTM_HOST=https://securegw-stage.paytm.in
# Payment attempt lifetime and how long an unpaid order waits before expiring (minutes)
QP_PAYMENT_TTL_MIN=15
QP_ORDER_PAYMENT_WINDOW_MIN=30
# Serve apps/web (customer) and apps/admin (dashboard) from Node; Caddy may serve them instead later
QP_SERVE_STATIC=true
# Admin accounts: npm run admin:create   (no default admin exists)
